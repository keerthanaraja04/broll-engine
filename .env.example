# =============================================================================
# broll-engine — environment variable reference
#
# Copy this file to .env and fill in the two required secrets.
# All other values have sensible defaults for local development.
#
# REQUIRED secrets:
#   GROQ_API_KEY      — obtain at https://console.groq.com
#   PIXABAY_API_KEY   — obtain at https://pixabay.com/api/docs/
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=broll-engine
APP_ENV=development           # development | staging | production
APP_VERSION=0.1.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_ROOT_PATH=

# -----------------------------------------------------------------------------
# Secrets — REQUIRED
# -----------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
PIXABAY_API_KEY=your-pixabay-api-key-here

# -----------------------------------------------------------------------------
# Groq / LLM
# -----------------------------------------------------------------------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama3-8b-8192
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3
GROQ_REQUEST_TIMEOUT_SECONDS=60.0
GROQ_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Pixabay
# -----------------------------------------------------------------------------
PIXABAY_BASE_URL=https://pixabay.com/api
PIXABAY_VIDEO_BASE_URL=https://pixabay.com/api/videos
PIXABAY_RESULTS_PER_PAGE=10
PIXABAY_MIN_WIDTH=1280
PIXABAY_MIN_HEIGHT=720
PIXABAY_VIDEO_TYPE=film          # film | animation | all

# -----------------------------------------------------------------------------
# Score / relevance thresholds
# -----------------------------------------------------------------------------
BROLL_MIN_RELEVANCE_SCORE=0.6
BROLL_MAX_CLIP_DURATION_SECONDS=30.0
BROLL_MIN_CLIP_DURATION_SECONDS=2.0
BROLL_MAX_CLIPS_PER_JOB=20
BROLL_TARGET_CLIPS_PER_SEGMENT=3

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
PIPELINE_CONCURRENCY=4
PIPELINE_STEP_TIMEOUT_SECONDS=300.0
PIPELINE_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# FFmpeg / Media
# -----------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=0                  # 0 = auto-detect
MEDIA_OUTPUT_FORMAT=mp4
MEDIA_VIDEO_CODEC=libx264
MEDIA_AUDIO_CODEC=aac
MEDIA_CRF=23                      # 0 (lossless) – 51 (worst); 18–28 is typical
MEDIA_PRESET=medium               # ultrafast | superfast | veryfast | faster | fast | medium | slow | slower | veryslow
FONT_DIR=/usr/share/fonts/truetype/noto
SUBTITLE_FONT=NotoSans

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=broll
POSTGRES_USER=broll
POSTGRES_PASSWORD=broll
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=30.0
POSTGRES_ECHO_SQL=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_JOB_TTL_SECONDS=86400       # 24 hours

# -----------------------------------------------------------------------------
# Object Storage (MinIO / S3-compatible)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_RAW=broll-raw
STORAGE_BUCKET_PROCESSED=broll-processed
STORAGE_BUCKET_FINAL=broll-final
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=3600

# -----------------------------------------------------------------------------
# ARQ / Worker
# -----------------------------------------------------------------------------
WORKER_QUEUE_NAME=broll:default
WORKER_MAX_JOBS=10
WORKER_POLL_DELAY_SECONDS=0.5
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_KEEP_RESULT_SECONDS=86400
WORKER_RETRY_JOBS=true
WORKER_MAX_TRIES=3

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60             # max requests per window per IP
RATE_LIMIT_WINDOW_SECONDS=60       # sliding window size in seconds
RATE_LIMIT_EXEMPT_PATHS=["/health","/ready","/docs","/openapi.json"]

# -----------------------------------------------------------------------------
# API Token Authentication
# -----------------------------------------------------------------------------
API_AUTH_ENABLED=false             # set true in staging/production
API_TOKENS=[]                      # comma-separated list of valid bearer tokens
API_TOKEN_HEADER=Authorization

# -----------------------------------------------------------------------------
# Idempotency
# -----------------------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400      # 24 h — how long Idempotency-Key entries live
IDEMPOTENCY_REDIS_PREFIX=idem:

# -----------------------------------------------------------------------------
# Jobs
# -----------------------------------------------------------------------------
AUDIO_MAX_DURATION_SECONDS=600.0   # 10 minutes
AUDIO_ALLOWED_EXTENSIONS=["mp3","mp4","wav","m4a","ogg","webm","flac"]
AUDIO_MAX_FILE_SIZE_BYTES=104857600  # 100 MB
VALID_ASPECT_RATIOS=["16:9","9:16","1:1"]
JOB_PAGE_SIZE_DEFAULT=20
JOB_PAGE_SIZE_MAX=100

# -----------------------------------------------------------------------------
# Callback / Webhook
# -----------------------------------------------------------------------------
CALLBACK_HMAC_SECRET=              # leave blank to skip HMAC signing
CALLBACK_MAX_RETRIES=3
CALLBACK_RETRY_DELAY_SECONDS=5.0
CALLBACK_TIMEOUT_SECONDS=10.0
CALLBACK_SIGNATURE_HEADER=X-IncuBrix-Signature

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                   # json | text
LOG_INCLUDE_TRACE=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=false
